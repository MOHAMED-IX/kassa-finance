{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "Represents the authenticated user's account profile and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User's unique Firebase auth ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User's primary email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User's display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "description": "Account setup ISO date string",
          "maxLength": 64
        },
        "hasMigratedLocalData": {
          "type": "boolean",
          "description": "Whether local browser data has already been migrated"
        },
        "activeMonth": {
          "type": "integer",
          "description": "User currently selected active month (1-12)"
        },
        "activeYear": {
          "type": "integer",
          "description": "User currently selected active year"
        },
        "activeCycleId": {
          "type": "string",
          "description": "User currently selected active spending cycle ID",
          "maxLength": 128
        },
        "periodMode": {
          "type": "string",
          "description": "Preferred period mode (month or cycle)",
          "enum": ["month", "cycle"]
        },
        "currency": {
          "type": "string",
          "description": "User preferred account currency display unit",
          "enum": ["EUR", "USD", "EGP"]
        },
        "categoryOrder": {
          "type": "array",
          "description": "User preferred custom ordering of category IDs for the Category Budgets & Spending section",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["uid", "email"]
    },
    "expense": {
      "title": "Expense",
      "description": "A single financial transaction / expense item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique expense ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Expense title or item name",
          "maxLength": 256
        },
        "amount": {
          "type": "number",
          "description": "Amount in EUR"
        },
        "categoryId": {
          "type": "string",
          "description": "Identifier of the category",
          "maxLength": 128
        },
        "store": {
          "type": "string",
          "description": "Store or merchant name",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Date formatted as YYYY-MM-DD",
          "maxLength": 32
        },
        "month": {
          "type": "number",
          "description": "Month number 1 to 12"
        },
        "year": {
          "type": "number",
          "description": "Calendar year"
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Whether this is recurring monthly"
        },
        "type": {
          "type": "string",
          "description": "fixed or variable",
          "enum": ["fixed", "variable"]
        },
        "notes": {
          "type": "string",
          "description": "Optional notes",
          "maxLength": 2048
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp created"
        }
      },
      "required": ["id", "name", "amount", "categoryId", "store", "date", "month", "year", "isRecurring", "type", "createdAt"]
    },
    "category": {
      "title": "Category",
      "description": "Budget category definition",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique category identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Category name",
          "maxLength": 128
        },
        "nameAr": {
          "type": "string",
          "description": "Optional Arabic category name",
          "maxLength": 128
        },
        "color": {
          "type": "string",
          "description": "Hex color code",
          "maxLength": 32
        },
        "iconName": {
          "type": "string",
          "description": "Lucide icon name identifier",
          "maxLength": 64
        },
        "defaultType": {
          "type": "string",
          "description": "Default expense type",
          "enum": ["fixed", "variable"]
        },
        "stores": {
          "type": "array",
          "description": "Common stores for this category"
        }
      },
      "required": ["id", "name", "color", "iconName", "defaultType", "stores"]
    },
    "monthRecord": {
      "title": "MonthRecord",
      "description": "Monthly income and category budgets record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID formatted as YYYY-M",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "year": {
          "type": "number",
          "description": "Calendar year"
        },
        "month": {
          "type": "number",
          "description": "Month number 1-12"
        },
        "income": {
          "type": "number",
          "description": "Monthly total income in EUR"
        },
        "budgets": {
          "type": "object",
          "description": "Key-value map of category ID to budget in EUR"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes for the month",
          "maxLength": 2048
        }
      },
      "required": ["year", "month", "income", "budgets"]
    },
    "spendingCycle": {
      "title": "SpendingCycle",
      "description": "User's personal salary/payment spending cycle period",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique cycle identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "startDate": {
          "type": "string",
          "description": "Cycle start date formatted as YYYY-MM-DD",
          "maxLength": 32
        },
        "endDate": {
          "type": "string",
          "description": "Cycle end date formatted as YYYY-MM-DD or null if currently active",
          "maxLength": 32
        },
        "income": {
          "type": "number",
          "description": "Total income for this spending cycle"
        },
        "expectedNextCycleIncome": {
          "type": "number",
          "description": "Optional planning expected income for next cycle"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or description for this cycle",
          "maxLength": 2048
        },
        "budgets": {
          "type": "object",
          "description": "Optional category budgets specific to this spending cycle"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "startDate", "createdAt"]
    },
    "bankTransaction": {
      "title": "BankTransaction",
      "description": "A ledger transaction representing bank balance events (opening, saving transfer, withdrawal, adjustment)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Type of bank transaction",
          "enum": ["opening-balance", "saving-transfer", "bank-withdrawal", "manual-adjustment"]
        },
        "amount": {
          "type": "number",
          "description": "Monetary amount in EUR"
        },
        "date": {
          "type": "string",
          "description": "Transaction date YYYY-MM-DD",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "description": "Optional memo or description",
          "maxLength": 2048
        },
        "sourcePeriodMode": {
          "type": "string",
          "description": "Period mode for saving transfers",
          "enum": ["calendar-month", "spending-cycle"]
        },
        "sourcePeriodId": {
          "type": "string",
          "description": "ID of period for saving transfers",
          "maxLength": 128
        },
        "targetId": {
          "type": "string",
          "description": "Optional ID of associated bank target",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "type", "amount", "date", "createdAt", "updatedAt"]
    },
    "bankTarget": {
      "title": "BankTarget",
      "description": "Virtual allocation target within total bank balance",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique target ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the target",
          "maxLength": 128
        },
        "targetAmount": {
          "type": "number",
          "description": "Goal amount in EUR"
        },
        "allocatedAmount": {
          "type": "number",
          "description": "Currently allocated amount in EUR"
        },
        "targetDate": {
          "type": "string",
          "description": "Optional deadline YYYY-MM-DD",
          "maxLength": 32
        },
        "icon": {
          "type": "string",
          "description": "Lucide icon identifier",
          "maxLength": 64
        },
        "accent": {
          "type": "string",
          "description": "Color accent identifier",
          "maxLength": 32
        },
        "active": {
          "type": "boolean",
          "description": "Whether the target is currently active"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the target goal has been reached"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "name", "targetAmount", "allocatedAmount", "active", "completed", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile and state document"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "expense",
      "description": "User's financial transactions"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "category",
      "description": "User's customized category list"
    },
    "/users/{userId}/monthRecords/{recordId}": {
      "schema": "monthRecord",
      "description": "User's monthly income and category budget allocations"
    },
    "/users/{userId}/spendingCycles/{cycleId}": {
      "schema": "spendingCycle",
      "description": "User's spending cycles between salary/payment dates"
    },
    "/users/{userId}/bankTransactions/{transactionId}": {
      "schema": "bankTransaction",
      "description": "User's bank ledger transactions"
    },
    "/users/{userId}/bankTargets/{targetId}": {
      "schema": "bankTarget",
      "description": "User's virtual bank savings targets"
    }
  }
}
