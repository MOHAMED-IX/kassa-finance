rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened primitive helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection validation endpoint
    match /test/connection {
      allow read: if isSignedIn();
    }

    // Schema validations
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'hasMigratedLocalData', 'activeMonth', 'activeYear', 'activeCycleId', 'periodMode', 'currency', 'categoryOrder']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('hasMigratedLocalData' in data) || data.hasMigratedLocalData is bool) &&
             (!('activeMonth' in data) || (data.activeMonth is number && data.activeMonth >= 1 && data.activeMonth <= 12)) &&
             (!('activeYear' in data) || (data.activeYear is number && data.activeYear >= 2000 && data.activeYear <= 2100)) &&
             (!('activeCycleId' in data) || (data.activeCycleId is string && data.activeCycleId.size() <= 128)) &&
             (!('periodMode' in data) || (data.periodMode is string && (data.periodMode == 'month' || data.periodMode == 'cycle'))) &&
             (!('currency' in data) || (data.currency is string && (data.currency == 'EUR' || data.currency == 'USD' || data.currency == 'EGP'))) &&
             (!('categoryOrder' in data) || (data.categoryOrder is list && data.categoryOrder.size() <= 100));
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'name', 'amount', 'categoryId', 'store', 'date', 'month', 'year', 'isRecurring', 'type', 'createdAt']) &&
             data.keys().hasOnly(['id', 'name', 'amount', 'categoryId', 'store', 'date', 'month', 'year', 'isRecurring', 'type', 'notes', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.name is string && data.name.size() <= 256 &&
             data.amount is number &&
             data.categoryId is string && data.categoryId.size() <= 128 &&
             data.store is string && data.store.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.month is number && data.month >= 1 && data.month <= 12 &&
             data.year is number && data.year >= 2000 && data.year <= 2100 &&
             data.isRecurring is bool &&
             data.type is string && (data.type == 'fixed' || data.type == 'variable') &&
             data.createdAt is number &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'color', 'iconName', 'defaultType', 'stores']) &&
             data.keys().hasOnly(['id', 'name', 'nameAr', 'color', 'iconName', 'defaultType', 'stores']) &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.name is string && data.name.size() <= 128 &&
             (!('nameAr' in data) || (data.nameAr is string && data.nameAr.size() <= 128)) &&
             data.color is string && data.color.size() <= 32 &&
             data.iconName is string && data.iconName.size() <= 64 &&
             data.defaultType is string && (data.defaultType == 'fixed' || data.defaultType == 'variable') &&
             data.stores is list && data.stores.size() <= 100;
    }

    function isValidMonthRecord(data) {
      return data.keys().hasAll(['year', 'month', 'income', 'budgets']) &&
             data.keys().hasOnly(['id', 'year', 'month', 'income', 'budgets', 'notes']) &&
             data.year is number && data.year >= 2000 && data.year <= 2100 &&
             data.month is number && data.month >= 1 && data.month <= 12 &&
             data.income is number &&
             data.budgets is map &&
             (!('id' in data) || (data.id is string && data.id.size() <= 64)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048));
    }

    function isValidSpendingCycle(data) {
      return data.keys().hasAll(['id', 'startDate', 'createdAt']) &&
             data.keys().hasOnly(['id', 'startDate', 'endDate', 'income', 'expectedNextCycleIncome', 'notes', 'createdAt', 'budgets']) &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.startDate is string && data.startDate.size() <= 32 &&
             (!('endDate' in data) || data.endDate == null || (data.endDate is string && data.endDate.size() <= 32)) &&
             (!('income' in data) || data.income == null || data.income is number) &&
             (!('expectedNextCycleIncome' in data) || data.expectedNextCycleIncome == null || data.expectedNextCycleIncome is number) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2048)) &&
             (!('budgets' in data) || data.budgets is map) &&
             data.createdAt is number;
    }

    function isValidBankTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'date', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'type', 'amount', 'date', 'note', 'sourcePeriodMode', 'sourcePeriodId', 'targetId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.type is string && (data.type == 'opening-balance' || data.type == 'saving-transfer' || data.type == 'bank-withdrawal' || data.type == 'manual-adjustment') &&
             data.amount is number &&
             data.date is string && data.date.size() <= 32 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 2048)) &&
             (!('sourcePeriodMode' in data) || (data.sourcePeriodMode is string && (data.sourcePeriodMode == 'calendar-month' || data.sourcePeriodMode == 'spending-cycle'))) &&
             (!('sourcePeriodId' in data) || (data.sourcePeriodId is string && data.sourcePeriodId.size() <= 128)) &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidBankTarget(data) {
      return data.keys().hasAll(['id', 'name', 'targetAmount', 'allocatedAmount', 'active', 'completed', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'name', 'targetAmount', 'allocatedAmount', 'targetDate', 'icon', 'accent', 'active', 'completed', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.name is string && data.name.size() <= 128 &&
             data.targetAmount is number &&
             data.allocatedAmount is number &&
             (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 32)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 64)) &&
             (!('accent' in data) || (data.accent is string && data.accent.size() <= 32)) &&
             data.active is bool &&
             data.completed is bool &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    // User account root document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming());
        allow update: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming());
        allow delete: if isOwner(userId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(categoryId) && isValidCategory(incoming());
        allow update: if isOwner(userId) && isValidId(categoryId) && isValidCategory(incoming());
        allow delete: if isOwner(userId);
      }

      // Month records subcollection
      match /monthRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidMonthRecord(incoming());
        allow update: if isOwner(userId) && isValidId(recordId) && isValidMonthRecord(incoming());
        allow delete: if isOwner(userId);
      }

      // Spending cycles subcollection
      match /spendingCycles/{cycleId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cycleId) && isValidSpendingCycle(incoming());
        allow update: if isOwner(userId) && isValidId(cycleId) && isValidSpendingCycle(incoming());
        allow delete: if isOwner(userId);
      }

      // Bank transactions subcollection
      match /bankTransactions/{txId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(txId) && isValidBankTransaction(incoming());
        allow update: if isOwner(userId) && isValidId(txId) && isValidBankTransaction(incoming());
        allow delete: if isOwner(userId);
      }

      // Bank targets subcollection
      match /bankTargets/{targetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(targetId) && isValidBankTarget(incoming());
        allow update: if isOwner(userId) && isValidId(targetId) && isValidBankTarget(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}

